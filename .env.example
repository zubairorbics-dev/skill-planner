# GEMINI_API_KEY: Required for server-side Gemini AI roadmap generation.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000 in AI Studio preview)
PORT="3000"

# Separate Admin Panel Credentials (override in production secrets)
ADMIN_EMAIL="admin@smartskillplanner.com"
ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
ADMIN_SESSION_SECRET="CHANGE_ME_RANDOM_HEX_SECRET"

{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Learner or administrator account profile, background, skills, career goal, and study schedule.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Authentication user UID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160,
          "description": "User email address (PII)."
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin"],
          "description": "Access role for RBAC."
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Full display name."
        },
        "education": {
          "type": "string",
          "maxLength": 80,
          "description": "Highest education level."
        },
        "fieldOfStudy": {
          "type": "string",
          "maxLength": 100,
          "description": "Primary field of study."
        },
        "profession": {
          "type": "string",
          "maxLength": 100,
          "description": "Current profession or role."
        },
        "experienceLevel": {
          "type": "string",
          "enum": ["student", "junior", "mid", "senior"],
          "description": "Current career experience tier."
        },
        "currentSkills": {
          "type": "array",
          "description": "Up to 25 current skills held by the user."
        },
        "careerGoal": {
          "type": "string",
          "maxLength": 600,
          "description": "Target career objective statement."
        },
        "targetRole": {
          "type": "string",
          "maxLength": 120,
          "description": "Target job title."
        },
        "availableHoursPerDay": {
          "type": "number",
          "description": "Available learning hours per day (0.5 to 6)."
        },
        "preferredDays": {
          "type": "array",
          "description": "Preferred study days of the week."
        },
        "onboardingCompleted": {
          "type": "boolean",
          "description": "Whether the learner has completed the onboarding wizard."
        },
        "roadmapCount": {
          "type": "number",
          "description": "Total number of roadmaps generated by the user."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-modified timestamp."
        }
      },
      "required": [
        "uid",
        "email",
        "role",
        "fullName",
        "education",
        "fieldOfStudy",
        "profession",
        "experienceLevel",
        "currentSkills",
        "careerGoal",
        "targetRole",
        "availableHoursPerDay",
        "preferredDays",
        "onboardingCompleted",
        "roadmapCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "Roadmap": {
      "title": "Roadmap",
      "description": "AI-generated structured learning roadmap containing skill gap analysis, phases, and milestones.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "goalText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "targetRole": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "gapAnalysis": {
          "type": "object",
          "description": "Structured skill gap analysis with have, improve, and new skill arrays."
        },
        "phases": {
          "type": "array",
          "description": "Ordered list of learning phases with milestones."
        },
        "totalTasks": {
          "type": "number"
        },
        "completedTasks": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["active", "archived"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "goalText",
        "targetRole",
        "gapAnalysis",
        "phases",
        "totalTasks",
        "completedTasks",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Task": {
      "title": "Task",
      "description": "Individual scheduled learning task linked to a roadmap milestone with curated resources.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "roadmapId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "phaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "milestoneId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "type": "string",
          "enum": ["theory", "practice", "project"]
        },
        "estMinutes": {
          "type": "number"
        },
        "dayOffset": {
          "type": "number"
        },
        "resources": {
          "type": "array",
          "description": "Up to 5 verified external study resources."
        },
        "isCompleted": {
          "type": "boolean"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "roadmapId",
        "phaseId",
        "milestoneId",
        "userId",
        "title",
        "type",
        "estMinutes",
        "dayOffset",
        "resources",
        "isCompleted",
        "createdAt",
        "updatedAt"
      ]
    },
    "AiLog": {
      "title": "AiLog",
      "description": "Immutable audit log entry for every Gemini roadmap generation request.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "userEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "promptSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "responseSummary": {
          "type": "string",
          "maxLength": 12000
        },
        "status": {
          "type": "string",
          "enum": ["success", "error"]
        },
        "errorMessage": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "userName",
        "userEmail",
        "promptSummary",
        "prompt",
        "responseSummary",
        "status",
        "errorMessage",
        "createdAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Server-managed administrator membership record.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "maxLength": 160
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "/profiles/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles containing onboarding details, skills, goals, and schedule."
    },
    "/roadmaps/{roadmapId}": {
      "schema": { "$ref": "#/entities/Roadmap" },
      "description": "AI-generated learning roadmaps belonging to users."
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Individual daily tasks linked to roadmap milestones."
    },
    "/ai_logs/{logId}": {
      "schema": { "$ref": "#/entities/AiLog" },
      "description": "Immutable AI generation logs for admin auditing."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Admin role directory for Firestore RBAC."
    }
  }
}

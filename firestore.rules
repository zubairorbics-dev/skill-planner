rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'zubair.orbics@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerified() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Entity Validation Blueprints (Anti-Update-Gap)
    function isValidProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'email', 'role', 'fullName', 'education', 'fieldOfStudy',
          'profession', 'experienceLevel', 'currentSkills', 'careerGoal',
          'targetRole', 'availableHoursPerDay', 'preferredDays',
          'onboardingCompleted', 'roadmapCount', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'email', 'role', 'fullName', 'education', 'fieldOfStudy',
          'profession', 'experienceLevel', 'currentSkills', 'careerGoal',
          'targetRole', 'availableHoursPerDay', 'preferredDays',
          'onboardingCompleted', 'roadmapCount', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.role in ['user', 'admin'] &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100 &&
        data.education is string && data.education.size() <= 80 &&
        data.fieldOfStudy is string && data.fieldOfStudy.size() <= 100 &&
        data.profession is string && data.profession.size() <= 100 &&
        data.experienceLevel in ['student', 'junior', 'mid', 'senior'] &&
        data.currentSkills is list && data.currentSkills.size() <= 25 &&
        (data.currentSkills.size() == 0 || (data.currentSkills[0] is string && data.currentSkills[0].size() <= 60)) &&
        data.careerGoal is string && data.careerGoal.size() <= 600 &&
        data.targetRole is string && data.targetRole.size() <= 120 &&
        data.availableHoursPerDay is number && data.availableHoursPerDay >= 0.5 && data.availableHoursPerDay <= 6 &&
        data.preferredDays is list && data.preferredDays.size() <= 7 &&
        data.preferredDays.hasOnly(['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']) &&
        data.onboardingCompleted is bool &&
        data.roadmapCount is number && data.roadmapCount >= 0 && data.roadmapCount <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidGapAnalysis(gap) {
      return gap is map &&
        gap.keys().hasAll(['have', 'improve', 'new']) &&
        gap.keys().hasOnly(['have', 'improve', 'new']) &&
        gap.have is list && gap.have.size() <= 25 &&
        (gap.have.size() == 0 || (gap.have[0] is string && gap.have[0].size() <= 80)) &&
        gap.improve is list && gap.improve.size() <= 25 &&
        (gap.improve.size() == 0 || (gap.improve[0] is string && gap.improve[0].size() <= 80)) &&
        gap.new is list && gap.new.size() <= 25 &&
        (gap.new.size() == 0 || (gap.new[0] is string && gap.new[0].size() <= 80));
    }

    function isValidRoadmap(data, roadmapId) {
      return data.keys().hasAll([
          'id', 'userId', 'goalText', 'targetRole', 'gapAnalysis',
          'phases', 'totalTasks', 'completedTasks', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'goalText', 'targetRole', 'gapAnalysis',
          'phases', 'totalTasks', 'completedTasks', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == roadmapId &&
        isValidId(data.userId) &&
        data.goalText is string && data.goalText.size() >= 1 && data.goalText.size() <= 600 &&
        data.targetRole is string && data.targetRole.size() >= 1 && data.targetRole.size() <= 120 &&
        isValidGapAnalysis(data.gapAnalysis) &&
        data.phases is list && data.phases.size() >= 2 && data.phases.size() <= 8 &&
        data.phases[0] is map &&
        data.totalTasks is number && data.totalTasks >= 1 && data.totalTasks <= 200 &&
        data.completedTasks is number && data.completedTasks >= 0 && data.completedTasks <= data.totalTasks &&
        data.status in ['active', 'archived'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTask(data, taskId) {
      return data.keys().hasAll([
          'id', 'roadmapId', 'phaseId', 'milestoneId', 'userId',
          'title', 'type', 'estMinutes', 'dayOffset', 'resources',
          'isCompleted', 'completedAt', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'roadmapId', 'phaseId', 'milestoneId', 'userId',
          'title', 'type', 'estMinutes', 'dayOffset', 'resources',
          'isCompleted', 'completedAt', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == taskId &&
        isValidId(data.roadmapId) &&
        data.phaseId is string && data.phaseId.size() >= 1 && data.phaseId.size() <= 64 &&
        data.milestoneId is string && data.milestoneId.size() >= 1 && data.milestoneId.size() <= 64 &&
        isValidId(data.userId) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.type in ['theory', 'practice', 'project'] &&
        data.estMinutes is number && data.estMinutes >= 5 && data.estMinutes <= 600 &&
        data.dayOffset is number && data.dayOffset >= 1 && data.dayOffset <= 365 &&
        data.resources is list && data.resources.size() <= 5 &&
        (data.resources.size() == 0 || data.resources[0] is map) &&
        data.isCompleted is bool &&
        (data.completedAt == null || data.completedAt is timestamp) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAiLog(data, logId) {
      return data.keys().hasAll([
          'id', 'userId', 'userName', 'userEmail', 'promptSummary',
          'prompt', 'responseSummary', 'status', 'errorMessage', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'userName', 'userEmail', 'promptSummary',
          'prompt', 'responseSummary', 'status', 'errorMessage', 'createdAt'
        ]) &&
        isValidId(data.id) &&
        data.id == logId &&
        isValidId(data.userId) &&
        data.userId == request.auth.uid &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 100 &&
        data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 160 &&
        data.promptSummary is string && data.promptSummary.size() >= 1 && data.promptSummary.size() <= 240 &&
        data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 6000 &&
        data.responseSummary is string && data.responseSummary.size() <= 12000 &&
        data.status in ['success', 'error'] &&
        data.errorMessage is string && data.errorMessage.size() <= 1000 &&
        data.createdAt is timestamp;
    }

    // 4. Collection Rules

    // Profiles (PII Isolated: owner or admin only)
    match /profiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrappedAdmin();

      allow create: if isVerified() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidProfile(incoming(), userId) &&
        (incoming().role == 'user' || (incoming().role == 'admin' && isBootstrappedAdmin())) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerified() &&
        isValidId(userId) &&
        isValidProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() || (
            isOwner(userId) &&
            incoming().role == existing().role &&
            (
              // Action 1: Update profile & onboarding fields
              incoming().diff(existing()).affectedKeys().hasOnly([
                'fullName', 'education', 'fieldOfStudy', 'profession',
                'experienceLevel', 'currentSkills', 'careerGoal', 'targetRole',
                'availableHoursPerDay', 'preferredDays', 'onboardingCompleted',
                'roadmapCount', 'updatedAt'
              ]) ||
              // Action 2: Increment roadmap count when generating roadmap
              incoming().diff(existing()).affectedKeys().hasOnly([
                'roadmapCount', 'onboardingCompleted', 'updatedAt'
              ])
            )
          )
        );

      allow delete: if false;
    }

    // Roadmaps
    match /roadmaps/{roadmapId} {
      allow get: if isSignedIn() && isValidId(roadmapId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isBootstrappedAdmin());

      allow create: if isVerified() &&
        isValidId(roadmapId) &&
        isValidRoadmap(incoming(), roadmapId) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'active' &&
        incoming().completedTasks == 0 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerified() &&
        isValidId(roadmapId) &&
        isValidRoadmap(incoming(), roadmapId) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() || (
            existing().userId == request.auth.uid &&
            existing().status == 'active' &&
            (
              // Action 1: Update completed task counter
              incoming().diff(existing()).affectedKeys().hasOnly(['completedTasks', 'updatedAt']) ||
              // Action 2: Archive active roadmap when generating a new one
              (incoming().status == 'archived' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
            )
          )
        );

      allow delete: if false;
    }

    // Tasks
    match /tasks/{taskId} {
      allow get: if isSignedIn() && isValidId(taskId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isBootstrappedAdmin());

      allow create: if isVerified() &&
        isValidId(taskId) &&
        isValidTask(incoming(), taskId) &&
        incoming().userId == request.auth.uid &&
        incoming().isCompleted == false &&
        incoming().completedAt == null &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/roadmaps/$(incoming().roadmapId)) &&
        getAfter(/databases/$(database)/documents/roadmaps/$(incoming().roadmapId)).data.userId == request.auth.uid;

      allow update: if isVerified() &&
        isValidId(taskId) &&
        isValidTask(incoming(), taskId) &&
        incoming().id == existing().id &&
        incoming().roadmapId == existing().roadmapId &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() || (
            existing().userId == request.auth.uid &&
            // Action: Toggle completion status
            incoming().diff(existing()).affectedKeys().hasOnly(['isCompleted', 'completedAt', 'updatedAt'])
          )
        );

      allow delete: if false;
    }

    // AI Generation Logs (Immutable Audit Trail)
    match /ai_logs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isBootstrappedAdmin());

      allow create: if isVerified() &&
        isValidId(logId) &&
        isValidAiLog(incoming(), logId) &&
        incoming().createdAt == request.time;

      allow update, delete: if false;
    }

    // Admins Directory (Server/Console Managed)
    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isBootstrappedAdmin());
      allow list, create, update, delete: if false;
    }
  }
}

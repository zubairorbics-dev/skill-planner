{
  "expo": {
    "name": "Smart Skill Planner",
    "slug": "smart-skill-planner",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "smartskillplanner",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#4F46E5",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.smartskillplanner.app"
    },
    "android": {
      "package": "com.smartskillplanner.app",
      "versionCode": 1,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5"
      },
      "permissions": [
        "INTERNET"
      ]
    },
    "extra": {
      "apiUrl": "http://192.168.20.15:3000",
      "eas": {
        "projectId": "d7422fe0-2f1b-482e-9471-debb92769f3f"
      }
    },
    "owner": "zubair.orbics",
    "plugins": [
      "expo-asset",
      "expo-font"
    ]
  }
}
